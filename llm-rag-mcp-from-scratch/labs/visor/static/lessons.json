{
 "version": "1.0.0",
 "lessons": [
  {
   "id": 0,
   "title": {
    "en": "Before you start",
    "es": "Antes de empezar"
   }
  },
  {
   "id": 1,
   "title": {
    "en": "One token at a time",
    "es": "De a un token"
   },
   "visor": {
    "en": "Each next appears with its five bars; each generate, with its steps in order.",
    "es": "Cada next aparece con sus cinco barras; cada generate, con sus pasos en orden."
   }
  },
  {
   "id": 2,
   "title": {
    "en": "Tokens, not words",
    "es": "Tokens, no palabras"
   },
   "visor": {
    "en": "Each tokens call shows its pieces as chips and the count beside them.",
    "es": "Cada tokens muestra sus pedazos como fichas y la cuenta al lado."
   }
  },
  {
   "id": 3,
   "title": {
    "en": "Sampling",
    "es": "Muestreo"
   },
   "visor": {
    "en": "Each sample shows its draws; with a seed, the lines repeat.",
    "es": "Cada sample muestra sus sorteos; con semilla, las líneas se repiten."
   }
  },
  {
   "id": 4,
   "title": {
    "en": "The model remembers nothing",
    "es": "El modelo no recuerda nada"
   },
   "visor": {
    "en": "Each chat shows how many messages it sent and how full the context was; the rejection appears in red.",
    "es": "Cada chat muestra cuántos mensajes mandó y qué tan lleno estaba el contexto; el rechazo aparece en rojo."
   }
  },
  {
   "id": 5,
   "title": {
    "en": "Meaning as a vector",
    "es": "El significado como vector"
   },
   "visor": {
    "en": "Each similar shows its matrix, with the strongest pairs highlighted.",
    "es": "Cada similar muestra su matriz, con los pares más fuertes resaltados."
   }
  },
  {
   "id": 6,
   "title": {
    "en": "Attention",
    "es": "Atención"
   },
   "visor": {
    "en": "Put two next events side by side to compare their bars.",
    "es": "Poné dos eventos next uno al lado del otro para comparar sus barras."
   }
  },
  {
   "id": 7,
   "title": {
    "en": "From base model to assistant",
    "es": "De modelo base a asistente"
   },
   "visor": {
    "en": "Each template appears with its special tokens highlighted.",
    "es": "Cada template aparece con sus tokens especiales resaltados."
   }
  },
  {
   "id": 8,
   "title": {
    "en": "Size, quantization and hardware",
    "es": "Tamaño, cuantización y hardware"
   },
   "visor": {
    "en": "Each chat with timings shows the two speeds as bars.",
    "es": "Cada chat con timings muestra las dos velocidades como barras."
   }
  },
  {
   "id": 9,
   "title": {
    "en": "The chat API on the wire",
    "es": "La API de chat en el cable"
   },
   "visor": {
    "en": "Each chat with --raw shows its request and response; each --stream, its events in order.",
    "es": "Cada chat con --raw muestra su pedido y su respuesta; cada --stream, sus eventos en orden."
   }
  },
  {
   "id": 10,
   "title": {
    "en": "Structured output",
    "es": "Salida estructurada"
   },
   "visor": {
    "en": "Each extract shows the JSON and the verdict of the validation.",
    "es": "Cada extract muestra el JSON y el veredicto de la validación."
   }
  },
  {
   "id": 11,
   "title": {
    "en": "Tool calling",
    "es": "Tool calling"
   },
   "visor": {
    "en": "The rounds appear in order: request, call, result and answer.",
    "es": "Las vueltas aparecen en orden: pedido, llamada, resultado y respuesta."
   }
  },
  {
   "id": 12,
   "title": {
    "en": "Spring AI",
    "es": "Spring AI"
   },
   "visor": {
    "en": "Calls from the app appear like those of the lab, with the request Spring AI built.",
    "es": "Las llamadas de la app aparecen como las del laboratorio, con el pedido que armó Spring AI."
   }
  },
  {
   "id": 13,
   "title": {
    "en": "Why RAG",
    "es": "Por qué RAG"
   },
   "visor": {
    "en": "Each ask shows the prompt size, so you can compare without and with the document.",
    "es": "Cada ask muestra el tamaño del prompt, para comparar sin y con el documento."
   }
  },
  {
   "id": 14,
   "title": {
    "en": "Chunk and index",
    "es": "Partir e indexar"
   },
   "visor": {
    "en": "Each index shows the chunks per file and the example chunk.",
    "es": "Cada index muestra los chunks por archivo y el chunk de ejemplo."
   }
  },
  {
   "id": 15,
   "title": {
    "en": "Search",
    "es": "Buscar"
   },
   "visor": {
    "en": "Each search shows its query, its mode and the chunks with their scores.",
    "es": "Cada search muestra su consulta, su modo y los chunks con sus puntajes."
   }
  },
  {
   "id": 16,
   "title": {
    "en": "Answer with sources",
    "es": "Responder con fuentes"
   },
   "visor": {
    "en": "Each ask shows the retrieved chunks, the final prompt and the citations of the answer.",
    "es": "Cada ask muestra los chunks recuperados, el prompt final y las citas de la respuesta."
   }
  },
  {
   "id": 17,
   "title": {
    "en": "Rerank and filter",
    "es": "Reordenar y filtrar"
   },
   "visor": {
    "en": "Each reranked search shows the order before and after.",
    "es": "Cada búsqueda reordenada muestra el orden antes y después."
   }
  },
  {
   "id": 18,
   "title": {
    "en": "Evaluate",
    "es": "Evaluar"
   },
   "visor": {
    "en": "Each evaluated question appears with its retrieval and its verdicts.",
    "es": "Cada pregunta evaluada aparece con su recuperación y sus veredictos."
   }
  },
  {
   "id": 19,
   "title": {
    "en": "Prompt injection",
    "es": "Prompt injection"
   },
   "visor": {
    "en": "The retrieval shows each chunk with its trust label.",
    "es": "La recuperación muestra cada chunk con su etiqueta de confianza."
   }
  },
  {
   "id": 20,
   "title": {
    "en": "What MCP standardizes",
    "es": "Qué estandariza MCP"
   },
   "visor": {
    "en": "Each MCP request and response appears with its method.",
    "es": "Cada pedido y respuesta MCP aparece con su método."
   }
  },
  {
   "id": 21,
   "title": {
    "en": "Two revisions on the wire",
    "es": "Dos revisiones en el cable"
   },
   "visor": {
    "en": "The messages of both revisions appear side by side, with their headers.",
    "es": "Los mensajes de las dos revisiones aparecen lado a lado, con sus encabezados."
   }
  },
  {
   "id": 22,
   "title": {
    "en": "An MCP server in Spring",
    "es": "Un servidor MCP en Spring"
   },
   "visor": {
    "en": "The messages over stdio appear like the ones over HTTP.",
    "es": "Los mensajes por stdio aparecen como los de HTTP."
   }
  },
  {
   "id": 23,
   "title": {
    "en": "A model that uses MCP",
    "es": "Un modelo que usa MCP"
   },
   "visor": {
    "en": "The round appears whole: tools/list, the model's request, the consent and tools/call.",
    "es": "La ronda aparece completa: tools/list, el pedido del modelo, el consentimiento y tools/call."
   }
  },
  {
   "id": 24,
   "title": {
    "en": "Security in MCP",
    "es": "Seguridad en MCP"
   },
   "visor": {
    "en": "Each tool description and result appears whole, as the model reads it.",
    "es": "Cada descripción y resultado de tool aparece completo, como lo lee el modelo."
   }
  },
  {
   "id": 25,
   "title": {
    "en": "An assistant you can defend",
    "es": "Un asistente que se puede defender"
   },
   "visor": {
    "en": "The whole run appears in order: tool calls, retrieval and answer.",
    "es": "La corrida entera aparece en orden: llamadas a tools, recuperación y respuesta."
   }
  }
 ],
