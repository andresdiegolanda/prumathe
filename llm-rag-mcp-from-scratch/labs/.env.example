# Optional settings of the kit. Copy this file to .env, in this folder, and fill in what you use.
# .env stays on your machine: it is in .gitignore and the course ZIP never includes it.

# CPU threads of each model server (chat, embed, rerank). The default is 4. More threads than free
# cores make generation slower, not faster. Recreate the servers after a change:
#   docker compose up -d --wait --force-recreate chat embed rerank
LLM_THREADS=4

# Only for the optional comparison of lesson 09 (docker compose run --rm lab chat "Say hi." --raw --remote):
# a provider with an OpenAI-compatible chat API. No lesson needs a key. LLM_BASE_URL is the base of the
# API, the part before /chat/completions, such as https://api.openai.com/v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
