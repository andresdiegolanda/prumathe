{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {"procurement": {
    "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {
        "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.json",
        "assets": [{"glob": "**/*", "input": "public"}], "styles": ["src/styles.css"],
        "outputPath": "dist"
      }},
      "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "procurement:build"}}
    }
  }}
}
